# ========================================================
# CineWeb — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores.
# ========================================================

# ─── PostgreSQL ───
POSTGRES_USER=postgres
POSTGRES_PASSWORD=60451
POSTGRES_DB=cineweb

# ─── JWT (Backend) ───
# Em produção, use chaves longas e aleatórias!
JWT_SECRET=cineweb-jwt-secret-dev-2026
JWT_REFRESH_SECRET=cineweb-jwt-refresh-secret-dev-2026

# ─── Mobile / Expo Go ───
# IP da sua máquina host na rede Wi-Fi local.
# Necessário para o Expo Go no celular físico se conectar ao Metro Bundler.
# Exemplo: 192.168.1.100
HOST_IP=0.0.0.0
